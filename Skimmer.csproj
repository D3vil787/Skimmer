<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Skimmer</AssemblyName>
    <RootNamespace>Skimmer</RootNamespace>
    <Version>0.2.0</Version>
    <Product>Skimmer</Product>
    <Description>Fast portable photo browser</Description>
    <ApplicationIcon>Skimmer.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- "full" = self-contained Skimmer.exe, "small" = Skimmer-small.exe; the updater downloads the same variant -->
  <PropertyGroup>
    <SkimmerVariant Condition="'$(SkimmerVariant)' == ''">full</SkimmerVariant>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Variant</_Parameter1>
      <_Parameter2>$(SkimmerVariant)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Portable single exe: dotnet publish -c Release -p:PublishSingleFile=true -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' And '$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
